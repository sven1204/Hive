# ==============================
# Domaine (prod uniquement)
# ==============================
DOMAIN=TON_DOMAINE.COM
ACME_EMAIL=ton@email.com

# ==============================
# Backend
# ==============================
PORT=5050
MONGO_URI=mongodb+srv://<mongo-user>:<mongo-password>@<mongo-cluster>/hive?appName=Hive
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m
FRONT_URL=http://localhost:3000
# URL publique du backend (sert à construire l'URL de retour OAuth)
BACKEND_URL=http://localhost:5050

# ==============================
# Connexion Google / GitHub (optionnel : sans ces clés, les boutons sont masqués)
# Google : https://console.cloud.google.com/apis/credentials
#   URL de redirection autorisée : <BACKEND_URL>/api/auth/oauth/google/callback
# GitHub : https://github.com/settings/developers (OAuth App)
#   Authorization callback URL : <BACKEND_URL>/api/auth/oauth/github/callback
# ==============================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ==============================
# Mail (Zoho / SMTP)
# ==============================
MAIL_HOST=smtp.zoho.eu
MAIL_PORT=465
MAIL_USER=your-mail-user@example.com
MAIL_PASS=your-mail-password
MAIL_FROM_EMAIL=no-reply@example.com
MAIL_FROM_NAME=Hive

# ==============================
# Monitoring
# ==============================
GRAFANA_USER=admin
GRAFANA_PASSWORD=replace-me

# ==============================
# Abonnement Hive+ (Stripe) — facultatif
# Sans STRIPE_SECRET_KEY, les offres s'affichent avec « Bientôt disponible ».
# ==============================
STRIPE_SECRET_KEY=sk_test_replace-me
STRIPE_WEBHOOK_SECRET=whsec_replace-me
STRIPE_PRICE_PLUS_MONTHLY=price_replace-me
STRIPE_PRICE_PLUS_YEARLY=price_replace-me
STRIPE_PRICE_BOOST=price_replace-me
# Boosts inclus par facture Hive+ payée, et durée d'un boost (heures)
PLUS_BOOSTS_PER_MONTH=2
BOOST_HOURS=48
# Offre « membres fondateurs » (réelle et datée) : coupon Stripe « forever »
FOUNDERS_OFFER_ENDS_AT=2026-12-31T22:59:59Z
FOUNDERS_PERCENT_OFF=30
STRIPE_FOUNDERS_COUPON=replace-me

# Emails de test (aucun envoi réel) : MAIL_TRANSPORT=json
