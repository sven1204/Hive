# ==============================
# Domaine (prod uniquement)
# ==============================
DOMAIN=TON_DOMAINE.COM
ACME_EMAIL=ton@email.com

# ==============================
# Backend
# ==============================
PORT=5050
MONGO_URI=mongodb+srv://<mongo-user>:<mongo-password>@<mongo-cluster>/hive?appName=Hive
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m
FRONT_URL=http://localhost:3000

# ==============================
# Mail (Zoho / SMTP)
# ==============================
MAIL_HOST=smtp.zoho.eu
MAIL_PORT=465
MAIL_USER=your-mail-user@example.com
MAIL_PASS=your-mail-password
MAIL_FROM_EMAIL=no-reply@example.com
MAIL_FROM_NAME=Hive

# ==============================
# Monitoring
# ==============================
GRAFANA_USER=admin
GRAFANA_PASSWORD=replace-me
